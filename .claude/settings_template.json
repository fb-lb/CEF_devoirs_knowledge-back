// Ce template est le même au niveau global machine et au niveau local
// Tout dépend de la portée que l'on souhaite apporter à la configuration
// Ce template se veut exhaustif pour présenter les propriétés possibles mais elles ne sont pas indispensables
// Le template doit être adapté au projet
// Supprimer tous les commentaires et toutes les propriétés non utilisées

{
  "permissions": {
    "allow": [ // commandes autorisées sans demander confirmation
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run build)"
    ],
    "deny": [ // commandes interdites
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Read(.env)",  // lecture du fichier.env interdite, plus sûr que .claudeignore qui peut lire les fichiers mais pas les ajouter au contexte
      "Read(secrets/**)"
    ]
    // les actions non présentes dans allow ou deny peuvent nécessiter une confirmation selon la politique d'autorisation configurée.
  },
  "hooks": {   // exécuter automatiquement des actions selon des événements Claude Code
    "PreToolUse": [   // "SessionStart" || "PreToolUse" || "PostToolUse" || "Stop" || "Notification"
      {
        "matcher": "...",   //"Read" || "Write" || "Edit" || "Bash" ||....
        "hooks": [
          {
            "type": "command",
            "command": "..."
          }
        ]
      }
    ]
  },
  "env": {
    "NODE_ENV": "development"  // éviter "DATABASE_PASSWORD": "secret" car secret dans .env ou autre
  },
  "mcpServers": { // permet à Claude d'utiliser des outils externes
    "github": {
      "command": "..."
    },
    "postgres": {
      "command": "..."
    } // mais aussi Docker, fileSystem, navigateur, etc...
  },
  "model": "", // nom du modèle selon le projet / contexte : Haiku, Sonnet, Opus
  "effortLevel": "medium", // conditionne l'effort réalisé par le modèle utilisé
  "alwaysThinkingEnabled": false, // conditionne l'utilisation du mode "Réflexion"
  "showThinkingSummaries": true, // affiche les résumés de la réflexion lorsqu'elle est activée
  "statusLine": "", // permet de personnaliser la ligne d'état affichée dans Claude Code. Facultatif
  "cleanupPeriodDays": 30, // contrôle la durée de conservation de certains éléments locaux
  "includeCoAuthoredBy": true, // contrôle l'ajout de la mention Claude dans les commits
  "plugins": {}
  // d'autres propriétés sont encore possibles comme celles liées :
  // - permissions de fichiers
  // - plugins / marketplace
  // ...
  // mais là on a déjà l'essentiel
}